APPSHEET_APP_ID=REEMPLAZAR
APPSHEET_ACCESS_KEY=REEMPLAZAR
APPSHEET_DOMAIN=www.appsheet.com
APPSHEET_LOCALE=en-US
APPSHEET_TIMEZONE=Pacific SA Standard Time

# Lectura de fotografías desde Drive con Service Account.
PHOTO_FOLDER_ID=REEMPLAZAR
APP_ROOT_FOLDER_ID=REEMPLAZAR

# Lectura de SVG de alzaprimado desde Drive con Service Account.
SVG_FOLDER_ID=1kR2qPov-y262lcpGPyCfqTMjPVpg1lqP
# Cálculo del cierre local para seleccionar instantáneas históricas.
REPORT_TIMEZONE=America/Santiago

# V1.2.4: escritura del PDF mediante Google Apps Script Web App.
REPORT_WRITER_URL=https://script.google.com/macros/s/REEMPLAZAR/exec
REPORT_WRITER_TOKEN=REEMPLAZAR_CON_TOKEN_LARGO

# Ruta relativa que AppSheet guardará en INFORME[ARCHIVO_INFORME].
REPORT_APPSHEET_PATH=INFORMES_SEMANALES

# Seguridad del webhook AppSheet -> Cloud Run.
REPORT_WEBHOOK_TOKEN=REEMPLAZAR_CON_UN_TOKEN_LARGO

MAX_REPORT_PHOTOS=6

# Ya no es necesario para escribir PDFs en V1.2.4.
# Puede mantenerse temporalmente en Cloud Run sin afectar.
REPORT_FOLDER_ID=REEMPLAZAR
REPORT_FOLDER_NAME=INFORMES_SEMANALES


# V1.3 - reporte fotográfico diario
DAILY_REPORT_APPSHEET_PATH=REPORTES_FOTOGRAFICOS_DIARIOS

# V1.5.1 - pedidos de fierro
# Carpeta Drive donde AppSheet deja los .xls/.xlsx de pedidos.
# Si se omite, ARCHIVO_PEDIDO se resuelve desde APP_ROOT_FOLDER_ID.
FIERRO_PEDIDOS_FOLDER_ID=REEMPLAZAR
FIERRO_PEDIDOS_TABLE=PEDIDOS_FIERRO
FIERRO_PEDIDOS_DETALLE_TABLE=PEDIDOS_FIERRO_DETALLE
