APPSHEET_APP_ID=REEMPLAZAR
APPSHEET_ACCESS_KEY=REEMPLAZAR
APPSHEET_DOMAIN=www.appsheet.com
APPSHEET_LOCALE=en-US
APPSHEET_TIMEZONE=Pacific SA Standard Time

# Carpeta que contiene directamente las fotografías.
# Por compatibilidad, si PHOTO_FOLDER_ID queda vacío,
# se usará APP_ROOT_FOLDER_ID.
PHOTO_FOLDER_ID=REEMPLAZAR
APP_ROOT_FOLDER_ID=REEMPLAZAR

# Carpeta dedicada a los SVG de alzaprimado.
SVG_FOLDER_ID=1kR2qPov-y262lcpGPyCfqTMjPVpg1lqP

# Carpeta dedicada a los PDF de informes.
REPORT_FOLDER_ID=REEMPLAZAR

# Ruta que AppSheet debe guardar en INFORME[ARCHIVO_INFORME].
# Debe ser relativa a la ubicación que AppSheet reconoce para archivos.
REPORT_APPSHEET_PATH=INFORMES_SEMANALES

REPORT_WEBHOOK_TOKEN=REEMPLAZAR_CON_UN_TOKEN_LARGO
MAX_REPORT_PHOTOS=6

# Fallback V1.0; solo se usa si REPORT_FOLDER_ID no está definido.
REPORT_FOLDER_NAME=INFORMES_SEMANALES
